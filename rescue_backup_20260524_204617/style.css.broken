/* ==================================================
   SEND BUTTON VISUAL FIX
   Smaller, centered, ChatGPT-like.
================================================== */

#sendBtn {
  width: 42px !important;
  min-width: 42px !important;
  height: 42px !important;
  border-radius: 999px !important;
  padding: 0 !important;
  margin-right: 2px !important;
  display: grid !important;
  place-items: center !important;
  flex-shrink: 0 !important;
  overflow: hidden !important;

  background: rgba(255,255,255,.96) !important;
  color: #0b0d12 !important;
  border: none !important;

  font-size: 0 !important;
  line-height: 1 !important;

  box-shadow:
    0 10px 24px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.45) !important;
}

#sendBtn::before {
  content: "↑" !important;
  display: block !important;
  font-size: 22px !important;
  font-weight: 700 !important;
  line-height: 1 !important;
  transform: translateY(-1px) !important;
}

#sendBtn.is-stopping::before {
  content: "■" !important;
  font-size: 15px !important;
  transform: translateY(0) !important;
}

#sendBtn:hover {
  opacity: .96 !important;
  transform: translateY(-1px);
}

#sendBtn:active {
  transform: scale(.96);
}

@media (max-width: 780px) {
  .composer {
    padding: 10px !important;
    gap: 10px !important;
  }

  #sendBtn {
    width: 42px !important;
    min-width: 42px !important;
    height: 42px !important;
    margin-right: 0 !important;
  }

  #sendBtn::before {
    font-size: 21px !important;
  }

  #sendBtn.is-stopping::before {
    font-size: 15px !important;
  }
}

/* ==================================================
   PREMIUM RAINBOW AURORA BOTTOM GLOW
   Gemini-like vibe, but still NeuroMV style.
================================================== */

.main {
  position: relative;
  overflow: hidden;
}

/* Aurora glow layer behind chat/composer */
.main::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -220px;
  width: min(980px, 135vw);
  height: 460px;
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 0;

  background:
    radial-gradient(circle at 18% 78%, rgba(75, 130, 255, .34), transparent 34%),
    radial-gradient(circle at 38% 54%, rgba(90, 90, 255, .24), transparent 34%),
    radial-gradient(circle at 58% 50%, rgba(176, 82, 255, .25), transparent 34%),
    radial-gradient(circle at 78% 70%, rgba(255, 105, 210, .20), transparent 35%),
    radial-gradient(circle at 50% 92%, rgba(66, 255, 190, .16), transparent 36%);

  filter: blur(48px) saturate(135%);
  opacity: .88;
  animation: neuromvAuroraFloat 8s ease-in-out infinite alternate;
}

/* Soft dark overlay so rainbow stays premium, not too bright */
.main::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 45%;
  pointer-events: none;
  z-index: 1;

  background:
    linear-gradient(
      to top,
      rgba(11, 13, 18, .35),
      rgba(11, 13, 18, .10),
      transparent
    );
}

/* Keep real content above glow */
.topbar,
.chat,
.composer {
  position: relative;
  z-index: 2;
}

/* Composer gets subtle glassy reflection from aurora */
.composer {
  background:
    linear-gradient(135deg, rgba(25, 29, 40, .88), rgba(18, 21, 30, .82)) !important;
  border-color: rgba(255, 255, 255, .105) !important;
  box-shadow:
    0 22px 70px rgba(0,0,0,.34),
    0 0 42px rgba(116, 110, 255, .10),
    inset 0 1px 0 rgba(255,255,255,.09) !important;
}

.composer::before {
  content: "";
  position: absolute;
  inset: 1px;
  border-radius: inherit;
  pointer-events: none;
  background:
    linear-gradient(
      110deg,
      rgba(97, 174, 255, .10),
      transparent 28%,
      rgba(203, 105, 255, .10) 58%,
      transparent 82%
    );
  opacity: .65;
}

/* Buttons reflect rainbow a little */
.attach-btn,
.mode-picker-btn {
  background:
    linear-gradient(135deg, rgba(255,255,255,.08), rgba(255,255,255,.045)) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 8px 24px rgba(0,0,0,.16) !important;
}

.attach-btn:hover,
.mode-picker-btn:hover {
  background:
    linear-gradient(135deg, rgba(255,255,255,.13), rgba(255,255,255,.065)) !important;
}

/* Bottom glow animation */
@keyframes neuromvAuroraFloat {
  0% {
    transform: translateX(-50%) translateY(0) scale(1);
    opacity: .74;
    filter: blur(52px) saturate(125%);
  }

  50% {
    transform: translateX(-48%) translateY(-18px) scale(1.04);
    opacity: .92;
    filter: blur(46px) saturate(145%);
  }

  100% {
    transform: translateX(-52%) translateY(-8px) scale(1.02);
    opacity: .82;
    filter: blur(50px) saturate(138%);
  }
}

/* Mobile tuning: make glow visible but not cover text */
@media (max-width: 780px) {
  .main::before {
    bottom: -170px;
    width: 145vw;
    height: 390px;
    filter: blur(42px) saturate(140%);
    opacity: .88;
  }

  .main::after {
    height: 38%;
  }

  .composer {
    box-shadow:
      0 18px 54px rgba(0,0,0,.34),
      0 0 32px rgba(116, 110, 255, .12),
      inset 0 1px 0 rgba(255,255,255,.09) !important;
  }
}

/* Respect reduced motion */
@media (prefers-reduced-motion: reduce) {
  .main::before {
    animation: none !important;
  }
}

/* ==================================================
   NEW CHAT ONLY AURORA
   Aurora only appears when body has .is-new-chat.
================================================== */

.main::before,
.main::after {
  opacity: 0 !important;
}

body.is-new-chat .main::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -190px;
  width: min(1080px, 150vw);
  height: 520px;
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 0;
  opacity: 1 !important;

  background:
    radial-gradient(circle at 14% 76%, rgba(62, 145, 255, .58), transparent 34%),
    radial-gradient(circle at 34% 58%, rgba(86, 96, 255, .46), transparent 34%),
    radial-gradient(circle at 56% 52%, rgba(190, 83, 255, .46), transparent 35%),
    radial-gradient(circle at 78% 72%, rgba(255, 100, 210, .34), transparent 36%),
    radial-gradient(circle at 50% 92%, rgba(58, 255, 190, .28), transparent 38%);

  filter: blur(48px) saturate(160%);
  animation: neuromvAuroraFloat 8s ease-in-out infinite alternate;
}

body.is-new-chat .main::after {
  content: "";
  position: absolute;
  inset: auto 0 0 0;
  height: 48%;
  pointer-events: none;
  z-index: 1;
  opacity: 1 !important;
  background:
    linear-gradient(
      to top,
      rgba(11, 13, 18, .22),
      rgba(11, 13, 18, .04),
      transparent
    );
}

body:not(.is-new-chat) .main::before,
body:not(.is-new-chat) .main::after {
  display: none !important;
}

/* ==================================================
   MARKDOWN RENDER PATCH
   Tables/lists/paragraphs look clean.
================================================== */

.content h1,
.content h2,
.content h3 {
  margin: 18px 0 10px;
  line-height: 1.25;
  letter-spacing: -0.025em;
}

.content h1 { font-size: 1.55em; }
.content h2 { font-size: 1.32em; }
.content h3 { font-size: 1.14em; }

.content p {
  margin: 0 0 14px;
}

.content ul,
.content ol {
  margin: 8px 0 14px 22px;
  padding: 0;
}

.content li {
  margin: 5px 0;
}

.content table {
  width: 100%;
  border-collapse: collapse;
  margin: 14px 0 18px;
  border-radius: 14px;
  display: block;
  max-width: 100%;
  overflow-x: auto;
  border: 1px solid rgba(255,255,255,.10);
  background: rgba(255,255,255,.025);
}

.content thead {
  background: rgba(255,255,255,.08);
}

.content th,
.content td {
  padding: 10px 12px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  text-align: left;
  vertical-align: top;
  min-width: 120px;
}

.content th {
  color: rgba(255,255,255,.94);
  font-weight: 750;
}

.content td {
  color: rgba(255,255,255,.84);
}

.content em {
  color: rgba(255,255,255,.92);
}

.content blockquote {
  margin: 12px 0;
  padding: 10px 14px;
  border-left: 3px solid rgba(160,180,255,.55);
  background: rgba(255,255,255,.045);
  border-radius: 12px;
}

/* ==================================================
   ATTACHMENT PREVIEW CLEANUP
   Fix file card overflowing / X cut off on mobile keyboard.
================================================== */

.attachment-preview {
  max-width: 100%;
  overflow: visible;
}

.attach-card {
  max-width: min(420px, calc(100vw - 138px));
  min-width: 0;
  position: relative;
  display: grid !important;
  grid-template-columns: 46px minmax(0, 1fr) 30px;
  align-items: center;
  gap: 10px;
  padding: 8px 8px 8px 9px !important;
  border-radius: 18px !important;
}

.attach-card img,
.attach-card .file-icon {
  width: 46px !important;
  height: 46px !important;
  border-radius: 13px !important;
}

.attach-info {
  min-width: 0 !important;
}

.attach-info strong,
.attach-card strong {
  display: block;
  max-width: 100% !important;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.attach-info p,
.attach-card p {
  margin: 2px 0 0;
  white-space: nowrap;
}

.attach-card button,
#removeAttachBtn {
  width: 30px !important;
  height: 30px !important;
  min-width: 30px !important;
  border-radius: 999px !important;
  display: grid !important;
  place-items: center !important;
  font-size: 18px !important;
  line-height: 1 !important;
  position: static !important;
  transform: none !important;
}

@media (max-width: 780px) {
  .attach-card {
    max-width: calc(100vw - 155px);
    grid-template-columns: 42px minmax(0, 1fr) 28px;
    gap: 8px;
  }

  .attach-card img,
  .attach-card .file-icon {
    width: 42px !important;
    height: 42px !important;
  }

  .attach-info strong,
  .attach-card strong {
    font-size: 13px;
  }

  .attach-info p,
  .attach-card p {
    font-size: 12px;
  }
}

/* ==================================================
   ATTACHMENT PREVIEW POSITION FIX
   Keep file preview above textarea, not floating center.
================================================== */

.input-wrap {
  display: flex !important;
  flex-direction: column !important;
  align-items: stretch !important;
  justify-content: flex-end !important;
  min-width: 0 !important;
}

.attachment-preview {
  width: 100% !important;
  max-width: 100% !important;
  display: block !important;
  padding: 0 4px 6px !important;
  align-self: stretch !important;
}

.attachment-preview.hidden {
  display: none !important;
}

.attach-card {
  width: fit-content !important;
  max-width: min(420px, 100%) !important;
  margin: 0 !important;
  justify-self: start !important;
  align-self: flex-start !important;

  display: grid !important;
  grid-template-columns: 46px minmax(0, 1fr) 30px !important;
  align-items: center !important;
  gap: 10px !important;

  padding: 8px 8px 8px 9px !important;
  border-radius: 18px !important;
}

#input {
  width: 100% !important;
  min-width: 0 !important;
}

/* Mobile: preview remains inside composer, above placeholder/input */
@media (max-width: 780px) {
  .attachment-preview {
    padding: 0 2px 6px !important;
  }

  .attach-card {
    max-width: 100% !important;
    grid-template-columns: 42px minmax(0, 1fr) 28px !important;
  }
}

/* ==================================================
   SIDEBAR ACCOUNT BOTTOM PATCH
================================================== */

/* Put account section at the bottom of the sidebar */
.account-box {
  order: 999 !important;
  margin-top: auto !important;
  position: relative;
  display: grid;
  grid-template-columns: 34px minmax(0, 1fr) 34px !important;
  align-items: center;
  gap: 10px;
  padding: 34px 10px 10px !important;
}

/* Label "Account" above the account row */
.account-box::before {
  content: "Account";
  position: absolute;
  top: 10px;
  left: 10px;
  font-size: 12px;
  color: rgba(255,255,255,.48);
  font-weight: 600;
  letter-spacing: .01em;
}

/* Make sure chat history stays above account */
.history {
  min-height: 0 !important;
}

/* Cleaner exit button */
.account-box button,
#logoutBtn {
  width: 34px !important;
  height: 34px !important;
  border: 0 !important;
  border-radius: 12px !important;
  display: grid !important;
  place-items: center !important;
  background: rgba(255,255,255,.075) !important;
  color: rgba(255,255,255,.78) !important;
  transition: background .16s ease, color .16s ease, transform .16s ease;
}

.account-box button:hover,
#logoutBtn:hover {
  background: rgba(255,95,95,.16) !important;
  color: #ffb0b0 !important;
}

.account-box button:active,
#logoutBtn:active {
  transform: scale(.94);
}

#logoutBtn svg {
  width: 19px;
  height: 19px;
  fill: none;
  stroke: currentColor;
  stroke-width: 2.15;
  stroke-linecap: round;
  stroke-linejoin: round;
}

/* Account text stays neat */
.account-box strong {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

.account-box p {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==================================================
   PRO / ULTRA MODE OPTIONS
================================================== */

.mode-option.premium-mode-option {
  display: flex !important;
  align-items: center !important;
  gap: 10px !important;
}

.mode-option-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.20), transparent 36%),
    linear-gradient(135deg, rgba(90,140,255,.22), rgba(210,95,255,.18));
  border: 1px solid rgba(255,255,255,.10);
  flex: 0 0 auto;
}

.mode-option-copy {
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 2px;
}

.mode-option-copy strong {
  font-size: 14px;
  line-height: 1.1;
}

.mode-option-copy small {
  font-size: 12px;
  color: rgba(220,228,245,.56);
  line-height: 1.15;
}

/* ==================================================
   PRO / ULTRA FIRST-OPEN AURORA POPUP
================================================== */

.premium-mode-backdrop {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: grid;
  place-items: center;
  padding: 22px;
  background: rgba(4, 5, 12, .58);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.premium-mode-card {
  position: relative;
  width: min(430px, 100%);
  overflow: hidden;
  border-radius: 30px;
  padding: 1px;
  background:
    linear-gradient(135deg, rgba(255,255,255,.22), rgba(255,255,255,.06)),
    radial-gradient(circle at 20% 0%, rgba(80,150,255,.42), transparent 36%),
    radial-gradient(circle at 85% 20%, rgba(210,90,255,.34), transparent 38%),
    radial-gradient(circle at 50% 110%, rgba(72,255,196,.24), transparent 42%);
  box-shadow:
    0 34px 100px rgba(0,0,0,.50),
    0 0 70px rgba(110,130,255,.18);
  animation: premiumPopIn .18s ease-out both;
}

.premium-mode-card::before {
  content: "";
  position: absolute;
  inset: -45%;
  background:
    conic-gradient(
      from 140deg,
      transparent,
      rgba(90,160,255,.22),
      rgba(190,90,255,.20),
      rgba(70,255,195,.16),
      rgba(255,190,90,.14),
      transparent
    );
  opacity: .86;
  animation: premiumAuroraSpin 7s linear infinite;
}

.premium-mode-card::after {
  content: "";
  position: absolute;
  inset: 1px;
  border-radius: 29px;
  background:
    linear-gradient(180deg, rgba(20,22,34,.94), rgba(10,12,20,.94)),
    radial-gradient(circle at 30% 0%, rgba(255,255,255,.08), transparent 34%);
}

.premium-mode-inner {
  position: relative;
  z-index: 2;
  padding: 28px 24px 22px;
}

.premium-mode-badge {
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  margin-bottom: 18px;
  border-radius: 18px;
  font-size: 24px;
  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.24), transparent 34%),
    linear-gradient(135deg, rgba(100,150,255,.22), rgba(220,95,255,.16));
  border: 1px solid rgba(255,255,255,.14);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.16);
}

.premium-mode-inner h2 {
  margin: 0;
  color: rgba(255,255,255,.97);
  font-size: 23px;
  line-height: 1.18;
  letter-spacing: -.035em;
  font-weight: 780;
}

.premium-mode-subtitle {
  margin: 11px 0 0;
  color: rgba(226,232,246,.76);
  font-size: 15px;
  line-height: 1.48;
}

.premium-mode-footer {
  margin: 12px 0 22px;
  color: rgba(180,192,218,.68);
  font-size: 13.5px;
  line-height: 1.45;
}

.premium-mode-ok {
  width: 100%;
  height: 46px;
  border: 0;
  border-radius: 17px;
  cursor: pointer;
  color: #090b12;
  background: rgba(255,255,255,.94);
  font-weight: 780;
  letter-spacing: -.01em;
  box-shadow:
    0 12px 28px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.85);
}

.premium-mode-ok:active {
  transform: scale(.99);
}

@keyframes premiumAuroraSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes premiumPopIn {
  from {
    opacity: 0;
    transform: translateY(8px) scale(.975);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@media (max-width: 780px) {
  .premium-mode-inner {
    padding: 24px 21px 20px;
  }

  .premium-mode-inner h2 {
    font-size: 21px;
  }
}


/* ==================================================
   FINAL CHAT POLISH PATCH
   - clean > send button
   - clean square stop button
   - text-only shimmer statuses
   - user bubble max width
   - user markdown/code rendering
================================================== */

/* Send button: clean > style */
#sendBtn,
.send-btn {
  display: grid !important;
  place-items: center !important;
  width: 54px !important;
  height: 54px !important;
  min-width: 54px !important;
  border-radius: 999px !important;
  border: 0 !important;
  background: rgba(255,255,255,.94) !important;
  color: #07090f !important;
  font-size: 34px !important;
  line-height: 1 !important;
  font-weight: 520 !important;
  box-shadow:
    0 12px 28px rgba(0,0,0,.24),
    inset 0 1px 0 rgba(255,255,255,.9) !important;
  transform: none !important;
}

#sendBtn.send-arrow {
  font-family: ui-rounded, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
  padding-bottom: 4px !important;
}

#sendBtn.is-stopping,
.send-btn.is-stopping {
  background: rgba(255,255,255,.94) !important;
  color: #080a10 !important;
  font-size: 22px !important;
  font-weight: 900 !important;
  padding: 0 !important;
}

#sendBtn.is-stopping::before,
#sendBtn.is-stopping::after,
.send-btn.is-stopping::before,
.send-btn.is-stopping::after {
  display: none !important;
  content: none !important;
}

/* User bubble should not eat the whole screen */
.message.user {
  display: flex !important;
  justify-content: flex-end !important;
}

.message.user .bubble,
.user-message .bubble,
.bubble.user {
  width: fit-content !important;
  max-width: min(78vw, 680px) !important;
  overflow-wrap: anywhere !important;
  word-break: break-word !important;
}

@media (max-width: 780px) {
  .message.user .bubble,
  .user-message .bubble,
  .bubble.user {
    max-width: 82vw !important;
  }
}

/* Status-only assistant bubble should become invisible */
.message.assistant .bubble:has(.ai-status):not(:has(.content)):not(:has(.thought-time)),
.assistant-message .bubble:has(.ai-status):not(:has(.content)):not(:has(.thought-time)) {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  padding: 0 !important;
  margin: 8px 0 14px !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* Text-only shimmer status */
.ai-status,
.glossy-status,
.thinking-status,
.searching-status,
.image-status,
.tool-status,
.complex-status,
.ultra-public-status {
  display: inline-flex !important;
  align-items: center !important;
  width: fit-content !important;
  max-width: min(86vw, 680px) !important;
  padding: 0 !important;
  margin: 8px 0 14px !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  overflow: visible !important;
}

.glossy-status .status-shine,
.glossy-status::before {
  display: none !important;
  content: none !important;
}

.glossy-status .status-label {
  display: inline-block !important;
  max-width: min(86vw, 680px) !important;
  font-size: 15px !important;
  font-weight: 650 !important;
  line-height: 1.18 !important;
  letter-spacing: -0.018em !important;
  white-space: normal !important;

  background:
    linear-gradient(
      105deg,
      rgba(155,166,190,.58) 0%,
      rgba(245,248,255,.98) 38%,
      rgba(135,170,255,.92) 50%,
      rgba(230,238,255,.95) 62%,
      rgba(155,166,190,.58) 100%
    ) !important;
  background-size: 260% 100% !important;
  background-position: 0% 50% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
  text-shadow: none !important;
  animation: neuroStatusTextShimmer 2.15s ease-in-out infinite !important;
}

/* Ultra status slightly more premium, still no bubble */
.ultra-public-status .status-label {
  font-style: italic !important;
  background:
    linear-gradient(
      105deg,
      rgba(180,190,255,.62) 0%,
      rgba(255,255,255,.96) 36%,
      rgba(190,120,255,.92) 52%,
      rgba(100,220,255,.88) 68%,
      rgba(180,190,255,.62) 100%
    ) !important;
  background-size: 280% 100% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
}

/* Flash dot stays dot-only */
.ai-status.instant-status {
  padding: 0 !important;
  background: transparent !important;
}

.instant-dot {
  display: inline-block !important;
  width: 12px !important;
  height: 12px !important;
  border-radius: 999px !important;
  background: rgba(235,238,245,.88) !important;
  animation: neuroFlashDotScale .78s ease-in-out infinite !important;
}

/* User markdown rendering */
.message.user .bubble p,
.user-message .bubble p {
  margin: 0 0 10px !important;
}

.message.user .bubble p:last-child,
.user-message .bubble p:last-child {
  margin-bottom: 0 !important;
}

.message.user .bubble code,
.user-message .bubble code,
.bubble.user code {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace !important;
  font-size: .92em !important;
  padding: .12em .35em !important;
  border-radius: 7px !important;
  background: rgba(255,255,255,.12) !important;
  border: 1px solid rgba(255,255,255,.08) !important;
}

.message.user .bubble pre,
.user-message .bubble pre,
.bubble.user pre {
  max-width: 100% !important;
  overflow-x: auto !important;
  padding: 12px !important;
  border-radius: 13px !important;
  background: rgba(0,0,0,.28) !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  margin: 10px 0 !important;
}

.message.user .bubble pre code,
.user-message .bubble pre code,
.bubble.user pre code {
  background: transparent !important;
  border: 0 !important;
  padding: 0 !important;
}

/* Menu polish so Pro/Ultra subtitles do not look cramped */
.mode-option.premium-mode-option,
.mode-option {
  min-height: 58px !important;
}

.mode-option-copy small {
  white-space: normal !important;
  line-height: 1.2 !important;
}

@keyframes neuroStatusTextShimmer {
  0%, 100% { background-position: 0% 50%; opacity: .62; }
  42% { background-position: 100% 50%; opacity: 1; }
  70% { background-position: 145% 50%; opacity: .76; }
}

@keyframes neuroFlashDotScale {
  0%, 100% { transform: scale(.68); }
  50% { transform: scale(1.22); }
}

@media (prefers-reduced-motion: reduce) {
  .glossy-status .status-label,
  .instant-dot {
    animation: none !important;
  }
}

/* ==================================================
   FINAL GLOBAL AI STATUS: SHIMMER TEXT ONLY
   Applies to ALL AI status types, not only Ultra.
================================================== */

/* If assistant bubble only contains status, remove bubble look completely */
.message.assistant .bubble:has(> .ai-status:only-child),
.assistant-message .bubble:has(> .ai-status:only-child),
.message.assistant .bubble.status-only,
.assistant-message .bubble.status-only {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  outline: none !important;
  padding: 0 !important;
  margin: 8px 0 14px !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
}

/* All AI status containers become invisible wrappers */
.ai-status,
.ai-status.glossy-status,
.glossy-status,
.thinking-status,
.searching-status,
.image-status,
.tool-status,
.complex-status,
.ultra-public-status,
.god-public-status {
  display: inline-flex !important;
  align-items: center !important;
  width: fit-content !important;
  max-width: min(86vw, 720px) !important;

  padding: 0 !important;
  margin: 8px 0 14px !important;

  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  outline: none !important;

  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;

  overflow: visible !important;
  position: relative !important;
}

/* Kill old glossy pill layers */
.ai-status::before,
.ai-status::after,
.glossy-status::before,
.glossy-status::after,
.glossy-status .status-shine,
.ai-status .status-shine {
  display: none !important;
  content: none !important;
  opacity: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

/* Every status label gets shimmer */
.ai-status .status-label,
.glossy-status .status-label,
.thinking-status .status-label,
.searching-status .status-label,
.image-status .status-label,
.tool-status .status-label,
.complex-status .status-label,
.ultra-public-status .status-label,
.god-public-status .status-label {
  display: inline-block !important;
  max-width: min(86vw, 720px) !important;

  font-size: 15px !important;
  font-weight: 650 !important;
  line-height: 1.22 !important;
  letter-spacing: -0.018em !important;
  white-space: normal !important;

  background:
    linear-gradient(
      105deg,
      rgba(145, 156, 180, .55) 0%,
      rgba(245, 248, 255, .98) 36%,
      rgba(135, 170, 255, .92) 50%,
      rgba(230, 238, 255, .96) 64%,
      rgba(145, 156, 180, .55) 100%
    ) !important;

  background-size: 280% 100% !important;
  background-position: 0% 50% !important;

  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;

  text-shadow: none !important;
  animation: neuroGlobalStatusShimmer 2.15s ease-in-out infinite !important;
}

/* Slight premium shimmer for Pro/Ultra, still text-only */
.complex-status .status-label,
.ultra-public-status .status-label,
.god-public-status .status-label {
  background:
    linear-gradient(
      105deg,
      rgba(180,190,255,.62) 0%,
      rgba(255,255,255,.98) 35%,
      rgba(190,120,255,.94) 52%,
      rgba(100,220,255,.90) 68%,
      rgba(180,190,255,.62) 100%
    ) !important;
  background-size: 300% 100% !important;
  -webkit-background-clip: text !important;
  background-clip: text !important;
  color: transparent !important;
}

.ultra-public-status .status-label,
.god-public-status .status-label {
  font-style: italic !important;
}

/* Flash remains dot-only, no text */
.ai-status.instant-status {
  display: inline-flex !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
}

.instant-dot {
  display: inline-block !important;
  width: 12px !important;
  height: 12px !important;
  border-radius: 999px !important;
  background: rgba(235, 238, 245, .88) !important;
  animation: neuroFlashDotScale .78s ease-in-out infinite !important;
}

@keyframes neuroGlobalStatusShimmer {
  0%, 100% {
    background-position: 0% 50%;
    opacity: .62;
  }

  42% {
    background-position: 100% 50%;
    opacity: 1;
  }

  70% {
    background-position: 150% 50%;
    opacity: .76;
  }
}

@keyframes neuroFlashDotScale {
  0%, 100% {
    transform: scale(.68);
  }

  50% {
    transform: scale(1.22);
  }
}

@media (prefers-reduced-motion: reduce) {
  .ai-status .status-label,
  .glossy-status .status-label,
  .instant-dot {
    animation: none !important;
  }
}

/* ==================================================
   EMERGENCY MODE MENU RESCUE FIX
   Focus only: mode menu layout
================================================== */

:root {
  --composer-safe-height: 104px;
}

/* mode picker anchor */
.mode-picker,
.mode-switcher,
.composer-mode-picker {
  position: relative;
}

/* floating menu container */
#modeMenu,
.mode-menu {
  position: absolute !important;
  left: 14px !important;
  right: auto !important;
  bottom: calc(var(--composer-safe-height) + 14px) !important;

  width: min(360px, calc(100vw - 28px)) !important;
  max-width: calc(100vw - 28px) !important;
  max-height: min(62vh, 420px) !important;
  overflow-y: auto !important;

  padding: 12px !important;
  border-radius: 26px !important;

  background:
    linear-gradient(180deg, rgba(18,22,34,.94), rgba(10,14,24,.94)) !important;
  border: 1px solid rgba(255,255,255,.10) !important;
  box-shadow:
    0 24px 60px rgba(0,0,0,.42),
    inset 0 1px 0 rgba(255,255,255,.06) !important;

  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;

  z-index: 9999 !important;
}

/* hidden state tetap aman */
#modeMenu.hidden,
.mode-menu.hidden {
  display: none !important;
}

/* each option */
#modeMenu .mode-option,
.mode-menu .mode-option {
  display: grid !important;
  grid-template-columns: 54px minmax(0, 1fr) !important;
  align-items: center !important;
  column-gap: 14px !important;

  width: 100% !important;
  min-height: 72px !important;
  padding: 12px 14px !important;
  margin: 0 !important;

  border: 0 !important;
  border-radius: 20px !important;
  background: transparent !important;
  color: rgba(255,255,255,.96) !important;

  text-align: left !important;
  box-sizing: border-box !important;
}

#modeMenu .mode-option + .mode-option,
.mode-menu .mode-option + .mode-option {
  margin-top: 8px !important;
}

#modeMenu .mode-option:hover,
#modeMenu .mode-option.active,
.mode-menu .mode-option:hover,
.mode-menu .mode-option.active {
  background: rgba(120,130,255,.16) !important;
}

/* icon */
#modeMenu .mode-option-icon,
.mode-menu .mode-option-icon {
  width: 54px !important;
  height: 54px !important;
  min-width: 54px !important;
  border-radius: 18px !important;

  display: grid !important;
  place-items: center !important;

  font-size: 23px !important;

  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.16), transparent 36%),
    linear-gradient(135deg, rgba(78,98,150,.28), rgba(130,78,180,.22)) !important;
  border: 1px solid rgba(255,255,255,.08) !important;
}

/* text wrapper */
#modeMenu .mode-option-copy,
.mode-menu .mode-option-copy {
  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  align-items: flex-start !important;
  min-width: 0 !important;
  overflow: hidden !important;
}

/* title */
#modeMenu .mode-option-copy strong,
.mode-menu .mode-option-copy strong {
  display: block !important;
  font-size: 17px !important;
  line-height: 1.15 !important;
  font-weight: 760 !important;
  letter-spacing: -0.02em !important;
  color: rgba(255,255,255,.98) !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

/* subtitle */
#modeMenu .mode-option-copy small,
.mode-menu .mode-option-copy small {
  display: block !important;
  margin-top: 3px !important;
  font-size: 13px !important;
  line-height: 1.22 !important;
  color: rgba(220,228,245,.64) !important;

  white-space: normal !important;
  overflow-wrap: break-word !important;
  word-break: normal !important;
}

/* mobile tune */
@media (max-width: 640px) {
  #modeMenu,
  .mode-menu {
    left: 10px !important;
    width: min(340px, calc(100vw - 20px)) !important;
    max-width: calc(100vw - 20px) !important;
    bottom: calc(var(--composer-safe-height) + 10px) !important;
    padding: 10px !important;
    border-radius: 22px !important;
  }

  #modeMenu .mode-option,
  .mode-menu .mode-option {
    min-height: 68px !important;
    grid-template-columns: 50px minmax(0, 1fr) !important;
    column-gap: 12px !important;
    padding: 11px 12px !important;
    border-radius: 18px !important;
  }

  #modeMenu .mode-option-icon,
  .mode-menu .mode-option-icon {
    width: 50px !important;
    height: 50px !important;
    min-width: 50px !important;
    border-radius: 16px !important;
    font-size: 21px !important;
  }

  #modeMenu .mode-option-copy strong,
  .mode-menu .mode-option-copy strong {
    font-size: 16px !important;
  }

  #modeMenu .mode-option-copy small,
  .mode-menu .mode-option-copy small {
    font-size: 12.5px !important;
  }
}


/* ==================================================
   FINAL SEND BUTTON: > IDLE, ■ STOP
================================================== */

#sendBtn,
.send-btn {
  display: grid !important;
  place-items: center !important;
  width: 54px !important;
  height: 54px !important;
  min-width: 54px !important;
  border-radius: 999px !important;
  border: none !important;
  outline: none !important;
  background: rgba(255,255,255,.94) !important;
  color: #06080e !important;
  font-family: ui-rounded, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif !important;
  font-size: 31px !important;
  font-weight: 650 !important;
  line-height: 1 !important;
  padding: 0 0 3px 2px !important;
  box-shadow:
    0 12px 28px rgba(0,0,0,.24),
    inset 0 1px 0 rgba(255,255,255,.9) !important;
}

/* Kill any old arrow icon pseudo-elements */
#sendBtn::before,
#sendBtn::after,
.send-btn::before,
.send-btn::after {
  display: none !important;
  content: none !important;
}

/* Idle state */
#sendBtn.send-arrow {
  font-size: 31px !important;
  font-weight: 650 !important;
  padding: 0 0 3px 2px !important;
}

/* Stop state */
#sendBtn.is-stopping,
.send-btn.is-stopping {
  font-size: 20px !important;
  font-weight: 900 !important;
  padding: 0 !important;
  color: #06080e !important;
  background: rgba(255,255,255,.94) !important;
}

/* ==================================================
   FINAL STYLISH SEND BUTTON
   CSS-drawn chevron, not raw ">" text.
================================================== */

#sendBtn,
.send-btn {
  position: relative !important;
  display: grid !important;
  place-items: center !important;

  width: 54px !important;
  height: 54px !important;
  min-width: 54px !important;

  border-radius: 999px !important;
  border: none !important;
  outline: none !important;

  background:
    radial-gradient(circle at 35% 25%, rgba(255,255,255,.95), rgba(255,255,255,.86) 42%, rgba(232,235,243,.92) 100%) !important;

  color: #080a10 !important;
  box-shadow:
    0 14px 30px rgba(0,0,0,.25),
    inset 0 1px 0 rgba(255,255,255,.95),
    inset 0 -1px 0 rgba(0,0,0,.08) !important;

  padding: 0 !important;
  overflow: hidden !important;
}

/* remove raw text and old icon leftovers */
#sendBtn {
  font-size: 0 !important;
  line-height: 0 !important;
}

#sendBtn::before,
#sendBtn::after,
.send-btn::before,
.send-btn::after {
  content: "" !important;
  position: absolute !important;
  display: block !important;
  pointer-events: none !important;
}

/* Stylish chevron > */
#sendBtn.send-arrow::before {
  width: 15px !important;
  height: 15px !important;

  border-top: 4px solid #090b12 !important;
  border-right: 4px solid #090b12 !important;
  border-radius: 2px !important;

  transform: rotate(45deg) translateX(-1px) !important;
  left: 17px !important;
  top: 18px !important;

  background: transparent !important;
  box-shadow: none !important;
}

/* soft inner glint */
#sendBtn.send-arrow::after {
  width: 20px !important;
  height: 20px !important;
  border-radius: 999px !important;
  background: radial-gradient(circle, rgba(255,255,255,.55), transparent 62%) !important;
  top: 8px !important;
  left: 12px !important;
  opacity: .42 !important;
}

/* Stop square state */
#sendBtn.is-stopping::before {
  width: 16px !important;
  height: 16px !important;
  border-radius: 4px !important;
  background: #080a10 !important;
  left: 50% !important;
  top: 50% !important;
  transform: translate(-50%, -50%) !important;
  border: none !important;
  box-shadow: none !important;
}

#sendBtn.is-stopping::after {
  display: none !important;
}

/* Disabled/dim state if later needed */
#sendBtn:disabled,
.send-btn:disabled {
  opacity: .48 !important;
  cursor: not-allowed !important;
}

/* ==================================================
   FINAL MODE PICKER CLEANUP
   Fix broken Pro/Ultra layout and oversized floating menu.
================================================== */

/* Make composer the anchor zone */
.composer,
.composer-wrap,
.input-area {
  position: relative !important;
}

/* Main menu container */
#modeMenu,
.mode-menu {
  position: absolute !important;

  left: 0 !important;
  right: auto !important;
  bottom: calc(100% + 12px) !important;

  width: min(340px, calc(100vw - 34px)) !important;
  max-width: calc(100vw - 34px) !important;
  max-height: min(58vh, 430px) !important;
  overflow-y: auto !important;

  padding: 12px !important;
  border-radius: 26px !important;

  background:
    linear-gradient(180deg, rgba(18, 22, 34, .96), rgba(9, 12, 21, .96)) !important;
  border: 1px solid rgba(255,255,255,.11) !important;
  box-shadow:
    0 26px 76px rgba(0,0,0,.48),
    inset 0 1px 0 rgba(255,255,255,.08) !important;

  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;

  z-index: 9999 !important;
  box-sizing: border-box !important;
}

#modeMenu.hidden,
.mode-menu.hidden {
  display: none !important;
}

/* Menu items */
#modeMenu .mode-option,
.mode-menu .mode-option {
  width: 100% !important;
  min-height: 70px !important;

  display: grid !important;
  grid-template-columns: 52px minmax(0, 1fr) !important;
  align-items: center !important;
  column-gap: 14px !important;

  padding: 10px 13px !important;
  margin: 0 !important;

  border: none !important;
  border-radius: 20px !important;
  background: transparent !important;

  color: rgba(255,255,255,.96) !important;
  text-align: left !important;
  box-sizing: border-box !important;
}

#modeMenu .mode-option + .mode-option,
.mode-menu .mode-option + .mode-option {
  margin-top: 7px !important;
}

#modeMenu .mode-option.active,
.mode-menu .mode-option.active {
  background:
    linear-gradient(135deg, rgba(118,130,255,.22), rgba(126,88,210,.13)) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 8px 20px rgba(0,0,0,.14) !important;
}

#modeMenu .mode-option:hover,
.mode-menu .mode-option:hover {
  background: rgba(255,255,255,.06) !important;
}

/* Icons */
#modeMenu .mode-option-icon,
.mode-menu .mode-option-icon {
  width: 52px !important;
  height: 52px !important;
  min-width: 52px !important;

  display: grid !important;
  place-items: center !important;

  border-radius: 18px !important;
  font-size: 22px !important;

  background:
    radial-gradient(circle at 30% 22%, rgba(255,255,255,.18), transparent 35%),
    linear-gradient(135deg, rgba(80,105,170,.26), rgba(138,86,196,.20)) !important;
  border: 1px solid rgba(255,255,255,.09) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.10),
    0 6px 14px rgba(0,0,0,.18) !important;
}

/* Text wrapper */
#modeMenu .mode-option-copy,
.mode-menu .mode-option-copy {
  min-width: 0 !important;
  max-width: 100% !important;

  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;
  align-items: flex-start !important;

  overflow: hidden !important;
}

/* Title */
#modeMenu .mode-option-copy strong,
.mode-menu .mode-option-copy strong {
  display: block !important;
  width: 100% !important;

  font-size: 16.5px !important;
  line-height: 1.16 !important;
  font-weight: 780 !important;
  letter-spacing: -0.025em !important;

  color: rgba(255,255,255,.98) !important;

  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
}

/* Subtitle */
#modeMenu .mode-option-copy small,
.mode-menu .mode-option-copy small {
  display: block !important;
  width: 100% !important;

  margin-top: 4px !important;

  font-size: 13px !important;
  line-height: 1.22 !important;
  font-weight: 500 !important;

  color: rgba(222,229,245,.62) !important;

  white-space: normal !important;
  overflow-wrap: normal !important;
  word-break: normal !important;
}

/* Keep Ultra subtitle elegant */
#modeMenu .mode-option[data-mode="ultra"] .mode-option-copy small,
.mode-menu .mode-option[data-mode="ultra"] .mode-option-copy small {
  font-size: 12.7px !important;
  max-width: 210px !important;
}

/* Mobile tune */
@media (max-width: 780px) {
  #modeMenu,
  .mode-menu {
    left: 0 !important;
    bottom: calc(100% + 10px) !important;

    width: min(330px, calc(100vw - 28px)) !important;
    max-width: calc(100vw - 28px) !important;

    padding: 10px !important;
    border-radius: 24px !important;
  }

  #modeMenu .mode-option,
  .mode-menu .mode-option {
    min-height: 66px !important;
    grid-template-columns: 48px minmax(0, 1fr) !important;
    column-gap: 12px !important;
    padding: 9px 11px !important;
    border-radius: 18px !important;
  }

  #modeMenu .mode-option-icon,
  .mode-menu .mode-option-icon {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    border-radius: 16px !important;
    font-size: 20px !important;
  }

  #modeMenu .mode-option-copy strong,
  .mode-menu .mode-option-copy strong {
    font-size: 15.8px !important;
  }

  #modeMenu .mode-option-copy small,
  .mode-menu .mode-option-copy small {
    font-size: 12.4px !important;
  }
}

/* ==================================================
   MODE MENU HARD RESET FIX
   Fix oversized / clipped mode picker caused by old overrides.
================================================== */

/* Put menu in a stable mobile-safe position */
#modeMenu,
.mode-menu {
  position: fixed !important;
  left: 50% !important;
  right: auto !important;
  top: auto !important;
  bottom: 118px !important;
  transform: translateX(-50%) !important;

  width: min(360px, calc(100vw - 34px)) !important;
  max-width: min(360px, calc(100vw - 34px)) !important;
  min-width: 0 !important;

  max-height: min(56vh, 420px) !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;

  padding: 10px !important;
  margin: 0 !important;

  border-radius: 24px !important;
  box-sizing: border-box !important;

  background:
    linear-gradient(180deg, rgba(18,22,34,.96), rgba(9,12,21,.96)) !important;
  border: 1px solid rgba(255,255,255,.12) !important;
  box-shadow:
    0 28px 80px rgba(0,0,0,.48),
    inset 0 1px 0 rgba(255,255,255,.08) !important;

  backdrop-filter: blur(20px) !important;
  -webkit-backdrop-filter: blur(20px) !important;

  z-index: 99999 !important;
}

#modeMenu.hidden,
.mode-menu.hidden {
  display: none !important;
}

/* Reset option layout completely */
