}

#modeMenu .mode-option + .mode-option,
.mode-menu .mode-option + .mode-option {
  margin-top: 7px !important;
}

#modeMenu .mode-option.active,
.mode-menu .mode-option.active {
  background:
    linear-gradient(135deg, rgba(118,130,255,.22), rgba(126,88,210,.13)) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 8px 20px rgba(0,0,0,.14) !important;
}

/* Any icon inside option */
#modeMenu .mode-option-icon,
.mode-menu .mode-option-icon,
#modeMenu .mode-option > span:first-child,
.mode-menu .mode-option > span:first-child {
