  }

  #modeMenu .mode-option,
  .mode-menu .mode-option {
    min-height: 62px !important;
    padding: 8px 10px !important;
    gap: 11px !important;
  }

  #modeMenu .mode-option-icon,
  .mode-menu .mode-option-icon,
  #modeMenu .mode-option > span:first-child,
  .mode-menu .mode-option > span:first-child {
    flex-basis: 44px !important;
    width: 44px !important;
    height: 44px !important;
    min-width: 44px !important;
    max-width: 44px !important;
  }
}

/* ==================================================
   EMERGENCY SEND BUTTON CLICK FIX
================================================== */

.composer,
.composer *,
#sendBtn,
.send-btn {
  pointer-events: auto !important;
}

#sendBtn,
.send-btn {
  position: relative !important;
  z-index: 30 !important;
  cursor: pointer !important;
}

/* Hidden menu must not block composer */
#modeMenu.hidden,
.mode-menu.hidden {
  display: none !important;
  pointer-events: none !important;
}

/* Visible menu only blocks itself, not entire page */
#modeMenu,
.mode-menu {
  pointer-events: auto !important;
}
