:root {
  --bg: #0b0d12;
  --panel: #11141b;
  --panel-2: #171b24;
  --text: #f4f6fb;
  --muted: #9ca3b7;
  --line: rgba(255,255,255,.08);
  --soft: rgba(255,255,255,.06);
  --accent: #8ea2ff;

  --font-main:
    ui-sans-serif,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Roboto,
    "Helvetica Neue",
    Arial,
    sans-serif;

  --font-emoji:
    "Apple Color Emoji",
    "Segoe UI Emoji",
    "Noto Color Emoji",
    emoji;
}

* {
  box-sizing: border-box;
}

html,
body {
  margin: 0;
  width: 100%;
  height: 100%;
  background: var(--bg);
  color: var(--text);
  font-family: var(--font-main);
  overflow: hidden;
}

button,
textarea,
input {
  font-family: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  opacity: .6;
  cursor: not-allowed;
}

.hidden {
  display: none !important;
}

.app {
  width: 100%;
  height: 100vh;
  display: flex;
  background:
    radial-gradient(circle at top left, rgba(126,146,255,.16), transparent 32%),
    radial-gradient(circle at bottom right, rgba(190,120,255,.10), transparent 34%),
    var(--bg);
}

/* MODAL */

.modal {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  padding: 24px;
  background:
    radial-gradient(circle at top, rgba(142,162,255,.18), transparent 38%),
    rgba(7,9,13,.78);
  backdrop-filter: blur(18px);
}

.modal-card {
  position: relative;
  width: min(430px, 100%);
  padding: 28px;
  border-radius: 28px;
  background:
    linear-gradient(135deg, rgba(255,255,255,.12), rgba(255,255,255,.045));
  border: 1px solid rgba(255,255,255,.13);
  box-shadow: 0 30px 90px rgba(0,0,0,.36);
  text-align: center;
}

.modal-close {
  position: absolute;
  right: 14px;
  top: 14px;
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 12px;
  color: rgba(255,255,255,.82);
  background: rgba(255,255,255,.08);
  font-size: 20px;
}

.modal-card h1 {
  margin: 18px 0 8px;
  font-size: 30px;
  letter-spacing: -.04em;
}

.modal-card p {
  margin: 0 0 20px;
  color: var(--muted);
  line-height: 1.5;
}

.auth-tabs {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
  padding: 5px;
  margin: 18px 0 12px;
  border-radius: 18px;
  background: rgba(255,255,255,.06);
  border: 1px solid rgba(255,255,255,.1);
}

.auth-tabs button {
  border: 0;
  border-radius: 14px;
  padding: 10px 8px;
  background: transparent;
  color: rgba(255,255,255,.66);
  font-weight: 750;
}

.auth-tabs button.active {
  color: #fff;
  background: rgba(255,255,255,.12);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.12);
}

.auth-form {
  display: grid;
  gap: 10px;
}

.auth-form input {
  width: 100%;
  border: 1px solid rgba(255,255,255,.1);
  outline: 0;
  border-radius: 16px;
  padding: 12px 14px;
  background: rgba(255,255,255,.07);
  color: #fff;
}

.auth-form input::placeholder {
  color: rgba(255,255,255,.42);
}

.auth-form button {
  border: 0;
  border-radius: 16px;
  padding: 12px 14px;
  background: #fff;
  color: #101217;
  font-weight: 850;
}

.auth-error {
  min-height: 19px;
  margin: 12px 0 0 !important;
  color: #ff9a9a !important;
  font-size: 13px;
}

.auth-note {
  margin: 8px 0 0 !important;
  color: rgba(255,255,255,.45) !important;
  font-size: 12px;
}

/* LOGOS */

.logo,
.empty-logo,
.auth-logo,
.avatar {
  position: relative;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.logo,
.empty-logo {
  width: 42px;
  height: 42px;
  border-radius: 16px;
  background:
    radial-gradient(circle at 35% 25%, rgba(255,255,255,.9), transparent 16%),
    linear-gradient(135deg, #6a8bff, #a869ff 52%, #ff7adf);
  box-shadow:
    0 12px 28px rgba(111,130,255,.25),
    inset 0 1px 0 rgba(255,255,255,.35);
}

.auth-logo {
  width: 64px;
  height: 64px;
  margin: 0 auto;
  border-radius: 22px;
  background:
    radial-gradient(circle at 35% 25%, rgba(255,255,255,.9), transparent 16%),
    linear-gradient(135deg, #6a8bff, #a869ff 52%, #ff7adf);
  box-shadow:
    0 18px 50px rgba(111,130,255,.32),
    inset 0 1px 0 rgba(255,255,255,.35);
}

.logo span,
.empty-logo span,
.auth-logo span,
.avatar span {
  width: 54%;
  height: 54%;
  background: rgba(255,255,255,.94);
  clip-path: polygon(
    50% 0%,
    61% 36%,
    100% 50%,
    61% 64%,
    50% 100%,
    39% 64%,
    0% 50%,
    39% 36%
  );
  filter: drop-shadow(0 0 14px rgba(255,255,255,.38));
}

/* SIDEBAR */

.sidebar {
  width: 292px;
  height: 100%;
  flex-shrink: 0;
  background: rgba(17,20,27,.82);
  border-right: 1px solid var(--line);
  backdrop-filter: blur(18px);
  padding: 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: width .22s ease, padding .22s ease, transform .22s ease;
}

.app.sidebar-hidden .sidebar {
  width: 0;
  padding-left: 0;
  padding-right: 0;
  border-right: 0;
  overflow: hidden;
}

.sidebar-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.brand {
  display: flex;
  gap: 12px;
  align-items: center;
  padding: 4px 2px 10px;
  min-width: 0;
}

.brand-text {
  min-width: 0;
}

.brand h1 {
  margin: 0;
  font-size: 18px;
  letter-spacing: -.02em;
}

.brand p {
  margin: 2px 0 0;
  font-size: 12px;
  color: var(--muted);
}

.sidebar-close,
.new-chat,
.history-title,
.history-menu-btn,
.history-menu button,
.mobile-menu,
#sendBtn,
.mode-picker-btn,
.mode-option,
.attach-btn,
.top-auth button,
.top-user button {
  border: 0;
  color: var(--text);
}

.sidebar-close {
  width: 32px;
  height: 32px;
  border-radius: 10px;
  color: rgba(255,255,255,.72);
  background: rgba(255,255,255,.07);
  font-size: 20px;
}

.new-chat {
  width: 100%;
  border-radius: 14px;
  padding: 12px 14px;
  background: rgba(255,255,255,.08);
  font-size: 15px;
  text-align: left;
  transition: .2s;
}

.new-chat:hover {
  background: rgba(255,255,255,.12);
}

.account-box {
  display: grid;
  grid-template-columns: 34px 1fr 30px;
  gap: 10px;
  align-items: center;
  padding: 10px;
  border-radius: 16px;
  background: rgba(255,255,255,.055);
  border: 1px solid var(--line);
}

.account-avatar {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background:
    linear-gradient(135deg, rgba(142,162,255,1), rgba(178,130,255,1));
  color: #fff;
  font-weight: 900;
}

.account-box strong {
  display: block;
  font-size: 13px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.account-box p {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 11px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.account-box button {
  width: 30px;
  height: 30px;
  border: 0;
  border-radius: 10px;
  background: rgba(255,255,255,.08);
  color: rgba(255,255,255,.8);
}

.side-label {
  margin: 2px 0 0;
  font-size: 12px;
  color: var(--muted);
}

.history {
  flex: 1;
  overflow-y: auto;
  display: grid;
  gap: 6px;
  align-content: start;
  padding-right: 2px;
}

.history-empty {
  color: rgba(255,255,255,.42);
  font-size: 13px;
  padding: 10px 4px;
}

.history-item {
  position: relative;
  display: grid;
  grid-template-columns: 1fr 34px;
  align-items: center;
  border-radius: 13px;
  background: transparent;
}

.history-item:hover {
  background: rgba(255,255,255,.06);
}

.history-item.active {
  background: rgba(142,162,255,.16);
}

.history-title {
  width: 100%;
  min-width: 0;
  padding: 11px 10px 11px 12px;
  background: transparent;
  color: rgba(255,255,255,.76);
  text-align: left;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.history-item.active .history-title {
  color: #fff;
}

.history-actions {
  position: relative;
}

.history-menu-btn {
  width: 30px;
  height: 30px;
  border-radius: 10px;
  background: transparent;
  color: rgba(255,255,255,.58);
  font-size: 18px;
}

.history-menu-btn:hover {
  background: rgba(255,255,255,.08);
  color: #fff;
}

.history-menu {
  position: absolute;
  right: 0;
  top: 34px;
  z-index: 30;
  min-width: 128px;
  padding: 6px;
  border-radius: 14px;
  background: rgba(20,24,32,.96);
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 18px 50px rgba(0,0,0,.34);
  backdrop-filter: blur(18px);
}

.history-menu button {
  width: 100%;
  padding: 10px 10px;
  border-radius: 10px;
  background: transparent;
  text-align: left;
  color: rgba(255,255,255,.86);
}

.history-menu button:hover {
  background: rgba(255,255,255,.08);
}

.history-menu .danger {
  color: #ff9a9a;
}

/* MAIN */

.main {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.topbar {
  height: 68px;
  border-bottom: 1px solid var(--line);
  background: rgba(11,13,18,.62);
  backdrop-filter: blur(18px);
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 20px;
}

.top-title {
  min-width: 0;
  flex: 1;
}

.topbar h2 {
  margin: 0;
  font-size: 16px;
  letter-spacing: -.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.topbar p {
  margin: 3px 0 0;
  font-size: 12px;
  color: var(--muted);
}

.mobile-menu {
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  border-radius: 12px;
  background: rgba(255,255,255,.08);
}

.top-auth,
.top-user {
  display: flex;
  gap: 8px;
  align-items: center;
}

.top-auth button,
.top-user button {
  padding: 9px 12px;
  border-radius: 13px;
  background: rgba(255,255,255,.08);
  color: #fff;
  white-space: nowrap;
}

.top-auth .primary {
  background: #fff;
  color: #101217;
  font-weight: 800;
}

.top-user span {
  max-width: 180px;
  overflow: hidden;
  text-overflow: ellipsis;
  color: rgba(255,255,255,.82);
  font-size: 13px;
  white-space: nowrap;
}

/* CHAT */

.chat {
  flex: 1;
  overflow-y: auto;
  padding: 26px min(7vw, 80px);
}

.empty-state {
  height: 100%;
  display: grid;
  place-items: center;
  align-content: center;
  text-align: center;
  gap: 10px;
  color: var(--muted);
}

.empty-state h2 {
  margin: 10px 0 0;
  color: var(--text);
  font-size: clamp(28px, 4vw, 42px);
  letter-spacing: -.04em;
}

.empty-state p {
  margin: 0;
  font-size: 14px;
}

.message {
  width: 100%;
  display: flex;
  gap: 14px;
  margin: 0 auto 24px;
  max-width: 860px;
}

.message.user {
  justify-content: flex-end;
}

.message.assistant {
  justify-content: flex-start;
}

.avatar {
  width: 34px;
  height: 34px;
  border-radius: 13px;
  flex-shrink: 0;
  background:
    radial-gradient(circle at 35% 25%, rgba(255,255,255,.9), transparent 16%),
    linear-gradient(135deg, #6a8bff, #a869ff 52%, #ff7adf);
  box-shadow:
    0 10px 24px rgba(111,130,255,.22),
    inset 0 1px 0 rgba(255,255,255,.35);
}

.bubble {
  max-width: min(720px, 100%);
  min-width: 0;
  font-size: 15.5px;
  line-height: 1.65;
}

.message.user .bubble {
  background: rgba(255,255,255,.08);
  border: 1px solid var(--line);
  padding: 11px 14px;
  border-radius: 18px 18px 4px 18px;
  line-height: 1.55;
}

.message.assistant .bubble {
  padding-top: 3px;
}

.content {
  word-wrap: break-word;
}

.content strong {
  color: #fff;
}

.inline-code {
  padding: 2px 5px;
  border-radius: 6px;
  background: rgba(255,255,255,.08);
  border: 1px solid var(--line);
  font-size: .92em;
}

.chat-image {
  max-width: min(460px, 100%);
  border-radius: 18px;
  border: 1px solid var(--line);
  margin: 10px 0;
  display: block;
}

/* CODE */

.code-wrap {
  margin: 12px 0;
  border-radius: 16px;
  overflow: hidden;
  border: 1px solid var(--line);
  background: #07090d;
}

.code-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(255,255,255,.07);
  padding: 9px 12px;
  color: var(--muted);
  font-size: 12px;
}

.copy-code {
  border: 0;
  background: transparent;
  color: rgba(255,255,255,.82);
  font-size: 12px;
}

pre {
  margin: 0;
  padding: 14px;
  overflow-x: auto;
}

code {
  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    "Liberation Mono",
    monospace;
}

/* STATUS */

.ai-status {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin: 6px 0 10px;
  padding: 7px 12px;
  border-radius: 999px;
  font-size: 13px;
  line-height: 1;
  color: rgba(255,255,255,.88);
  background:
    linear-gradient(135deg, rgba(255,255,255,.13), rgba(255,255,255,.045));
  border: 1px solid rgba(255,255,255,.12);
  box-shadow:
    0 8px 22px rgba(0,0,0,.22),
    inset 0 1px 0 rgba(255,255,255,.14);
  backdrop-filter: blur(18px);
  overflow: hidden;
  position: relative;
}

.ai-status::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      110deg,
      transparent 0%,
      rgba(255,255,255,.16) 38%,
      transparent 72%
    );
  transform: translateX(-110%);
  animation: glossySweep 2.3s ease-in-out infinite;
}

.instant-status {
  padding: 7px;
  background: transparent;
  border: none;
  box-shadow: none;
  backdrop-filter: none;
}

.instant-status::before {
  display: none;
}

.instant-dot {
  width: 13px;
  height: 13px;
  border-radius: 999px;
  display: inline-block;
  background: rgba(255,255,255,.78);
  animation: instantPulse .85s ease-in-out infinite;
}

.status-orb {
  width: 9px;
  height: 9px;
  border-radius: 999px;
  background: currentColor;
  opacity: .9;
  box-shadow: 0 0 14px currentColor;
  animation: orbPulse 1.15s ease-in-out infinite;
}

.status-dots {
  display: inline-flex;
  gap: 3px;
}

.status-dots i {
  width: 3px;
  height: 3px;
  border-radius: 50%;
  background: currentColor;
  opacity: .35;
  animation: dotBlink 1.15s ease-in-out infinite;
}

.status-dots i:nth-child(2) {
  animation-delay: .15s;
}

.status-dots i:nth-child(3) {
  animation-delay: .3s;
}

.thinking-status {
  color: #e2eaff;
}

.searching-status {
  color: #d8fff1;
}

.image-status {
  color: #ffe1ff;
}

.thought-time {
  width: fit-content;
  margin: 2px 0 10px;
  font-size: 13px;
  line-height: 1.4;
  color: rgba(255,255,255,.48);
}

/* COMPOSER */

.composer {
  width: min(900px, calc(100% - 28px));
  margin: 0 auto 18px;
  padding: 10px;
  display: flex;
  gap: 10px;
  align-items: flex-end;
  border: 1px solid var(--line);
  border-radius: 22px;
  background: rgba(23,27,36,.82);
  box-shadow:
    0 20px 60px rgba(0,0,0,.28),
    inset 0 1px 0 rgba(255,255,255,.08);
  backdrop-filter: blur(18px);
  position: relative;
}

.attach-btn {
  width: 38px;
  height: 38px;
  border-radius: 14px;
  background: rgba(255,255,255,.07);
  font-size: 20px;
  flex-shrink: 0;
}

.attach-btn:hover {
  background: rgba(255,255,255,.11);
}

.mode-picker {
  position: relative;
  flex-shrink: 0;
}

.mode-picker-btn {
  height: 38px;
  padding: 0 11px;
  border-radius: 14px;
  background: rgba(255,255,255,.07);
  color: rgba(255,255,255,.86);
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  white-space: nowrap;
}

.mode-picker-btn:hover {
  background: rgba(255,255,255,.11);
}

.chev {
  color: rgba(255,255,255,.55);
  font-size: 15px;
  line-height: 1;
  transform: translateY(-1px);
}

.mode-menu {
  position: absolute;
  left: 0;
  bottom: calc(100% + 10px);
  width: 236px;
  padding: 7px;
  border-radius: 18px;
  background: rgba(20,24,32,.96);
  border: 1px solid rgba(255,255,255,.12);
  box-shadow: 0 22px 70px rgba(0,0,0,.38);
  backdrop-filter: blur(18px);
  z-index: 40;
}

.mode-option {
  width: 100%;
  display: grid;
  grid-template-columns: 32px 1fr;
  gap: 10px;
  align-items: center;
  padding: 10px;
  border-radius: 13px;
  background: transparent;
  text-align: left;
}

.mode-option:hover {
  background: rgba(255,255,255,.07);
}

.mode-option.active {
  background: rgba(142,162,255,.16);
}

.mode-option > span {
  width: 32px;
  height: 32px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  background: rgba(255,255,255,.08);
  font-family: var(--font-emoji);
}

.mode-option strong {
  display: block;
  font-size: 13px;
}

.mode-option p {
  margin: 2px 0 0;
  font-size: 12px;
  color: var(--muted);
}

.input-wrap {
  flex: 1;
  min-width: 0;
  display: grid;
  gap: 8px;
}

#input {
  width: 100%;
  resize: none;
  border: 0;
  outline: 0;
  color: var(--text);
  background: transparent;
  font-size: 15px;
  line-height: 1.5;
  max-height: 170px;
  padding: 9px 6px;
  min-width: 0;
}

#input::placeholder {
  color: rgba(255,255,255,.38);
}

#sendBtn {
  min-width: 66px;
  padding: 10px 14px;
  border-radius: 15px;
  font-weight: 700;
  background: #fff;
  color: #101217;
  flex-shrink: 0;
}

#sendBtn:hover {
  opacity: .92;
}

.attachment-preview {
  padding: 0 4px;
}

.attach-card {
  display: flex;
  align-items: center;
  gap: 10px;
  width: fit-content;
  max-width: 100%;
  padding: 8px 10px;
  border-radius: 16px;
  background: rgba(255,255,255,.07);
  border: 1px solid var(--line);
}

.attach-card img {
  width: 44px;
  height: 44px;
  object-fit: cover;
  border-radius: 12px;
}

.file-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: rgba(255,255,255,.08);
}

.attach-info {
  min-width: 0;
}

.attach-card strong {
  display: block;
  max-width: 280px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 13px;
}

.attach-card p {
  margin: 2px 0 0;
  color: var(--muted);
  font-size: 12px;
}

.attach-card button {
  width: 28px;
  height: 28px;
  border: 0;
  border-radius: 10px;
  background: rgba(255,255,255,.08);
  color: #fff;
  font-size: 18px;
}

/* MATHJAX + PRISM */

mjx-container {
  overflow-x: auto;
  overflow-y: hidden;
  max-width: 100%;
  padding: 2px 0;
}

.code-wrap pre[class*="language-"],
.code-wrap code[class*="language-"] {
  background: transparent !important;
  text-shadow: none !important;
  font-size: 13.5px;
  line-height: 1.55;
}

.code-wrap pre {
  background: #07090d !important;
}

.token.comment,
.token.prolog,
.token.doctype,
