/* ==================================================
   NEUROMV PROFESSIONAL LIMIT POPUP
================================================== */

.limit-modal {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: grid;
  place-items: center;
  padding: 24px;
  background: rgba(5, 7, 12, .64);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.limit-modal.hidden {
  display: none !important;
}

.limit-card {
  width: min(390px, 100%);
  padding: 26px;
  border-radius: 28px;
  text-align: center;
  background:
    linear-gradient(135deg, rgba(28, 32, 44, .96), rgba(18, 21, 31, .96));
  border: 1px solid rgba(255,255,255,.12);
  box-shadow:
    0 28px 90px rgba(0,0,0,.42),
    inset 0 1px 0 rgba(255,255,255,.10);
}

.limit-icon {
  width: 48px;
  height: 48px;
  margin: 0 auto 16px;
  border-radius: 999px;
  display: grid;
  place-items: center;
  font-size: 24px;
  font-weight: 900;
  color: rgba(255,255,255,.95);
  background:
    radial-gradient(circle at 30% 20%, rgba(255,255,255,.26), transparent 30%),
    linear-gradient(135deg, rgba(142,162,255,.95), rgba(200,120,255,.85));
  box-shadow: 0 14px 34px rgba(116,120,255,.22);
}

.limit-card h2 {
  margin: 0 0 9px;
  font-size: 24px;
  line-height: 1.12;
  letter-spacing: -.04em;
  color: rgba(255,255,255,.98);
}

.limit-card p {
  margin: 0 0 20px;
  color: rgba(220,228,240,.72);
  line-height: 1.5;
  font-size: 14px;
}

.limit-card button {
  width: 100%;
  border: 0;
  border-radius: 16px;
  padding: 12px 14px;
  background: rgba(255,255,255,.92);
  color: #101217;
  font-weight: 850;
}

#sendBtn.limit-locked,
#sendBtn:disabled.limit-locked {
  background: rgba(80, 84, 96, .55) !important;
  color: rgba(255,255,255,.34) !important;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.07),
    0 8px 20px rgba(0,0,0,.18) !important;
  cursor: not-allowed !important;
  opacity: 1 !important;
  transform: none !important;
}

#sendBtn.limit-locked::before,
#sendBtn:disabled.limit-locked::before {
  color: rgba(255,255,255,.38) !important;
}

#input.limit-locked {
  color: rgba(255,255,255,.55) !important;
}

