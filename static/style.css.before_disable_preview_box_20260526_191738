   Aurora only appears when body has .is-new-chat.
================================================== */

.main::before,
.main::after {
  opacity: 0 !important;
}

body.is-new-chat .main::before {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -190px;
  width: min(1080px, 150vw);
  height: 520px;
  transform: translateX(-50%);
  pointer-events: none;
  z-index: 0;
  opacity: 1 !important;

  background:
    radial-gradient(circle at 14% 76%, rgba(62, 145, 255, .58), transparent 34%),
    radial-gradient(circle at 34% 58%, rgba(86, 96, 255, .46), transparent 34%),
