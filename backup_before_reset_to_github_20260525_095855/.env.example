# =========================
# NEUROMV CORE
# =========================

APP_NAME=NeuroMV
SECRET_KEY=neuromvgod

SESSION_COOKIE_SECURE=false
FLASK_DEBUG=1

# =========================
# DATABASE / STORAGE
# =========================

DB_FILE=data/neuromv.db
MEMORY_FILE=data/chat_memory.json
FACTS_FILE=data/facts.json
UPLOAD_DIR=uploads

# Railway note:
# If using SQLite on Railway, mount Volume to /app/data.

# =========================
# TEXT / CHAT PROVIDERS
# =========================

GROQ_API_KEYS=
GROQ_API_KEY=

GEMINI_API_KEYS=
GEMINI_API_KEY=

CEREBRAS_API_KEYS=
CEREBRAS_API_KEY=

CLOUDFLARE_ACCOUNT_IDS=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKENS=
CLOUDFLARE_API_TOKEN=

# =========================
# OCR
# =========================

MISTRAL_API_KEYS=
MISTRAL_API_KEY=

# =========================
# SEARCH
# =========================

SERPAPI_API_KEYS=
SERPAPI_API_KEY=

SERPER_API_KEYS=
SERPER_API_KEY=

TAVILY_API_KEYS=
TAVILY_API_KEY=

# =========================
# MODELS
# =========================

INSTANT_PROVIDER=groq
THINKING_PROVIDER=gemini

INSTANT_MODEL=openai/gpt-oss-120b
THINKING_MODEL=gemini-2.5-flash

# Optional examples:
# THINKING_PROVIDER=cerebras
# THINKING_MODEL=gpt-oss-120b
#
# THINKING_PROVIDER=cloudflare
# THINKING_MODEL=@cf/meta/llama-3.1-8b-instruct
#
# THINKING_PROVIDER=gemini
# THINKING_MODEL=gemini-2.5-flash

# =========================
# RUNTIME
# =========================

MAX_RECENT_MESSAGES=20
REQUEST_TIMEOUT=60
MAX_PROVIDER_ATTEMPTS=10

# =========================
# LIMITS
# =========================

DAILY_LIMIT=30
UPLOAD_LIMIT=5
FILE_LIMIT=5
IMAGE_LIMIT=5
SEARCH_LIMIT=10
URL_LIMIT=20
OCR_LIMIT=10
VISION_LIMIT=10

MAX_UPLOAD_MB=15
MAX_CONTEXT_CHARS=24000
